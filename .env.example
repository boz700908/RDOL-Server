# RDOL 后端环境变量示例
# 复制为 .env 后按需修改；.env 不提交到仓库

# ---------- WebSocket 服务（联机） ----------
# 游戏客户端连接的端口
SERVER_PORT=3005

# ---------- HTTP API（谱面 / 版本检查） ----------
API_PORT=3004
API_VERSION=2.0.0

# ---------- 数据库 ----------
# SQLite 单文件，无需账号密码。相对路径按工作目录解析
DB_FILE=./data/rdonline.db

# ---------- 谱面存储 ----------
# .rdzip 落盘目录
CHART_DIR=./charts

# 对外可访问的基础地址，用于拼出下载直链；留空则由请求的 Host 推导
# 例：CHART_BASE_URL=http://47.238.109.184:3004
CHART_BASE_URL=

# 上传大小上限（MB）
MAX_UPLOAD_MB=64

# 管理接口令牌；留空则不校验（仅限内网使用）
API_TOKEN=
