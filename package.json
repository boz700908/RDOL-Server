{
  "name": "rdol-server",
  "version": "2.0.0",
  "description": "RhythmDoctorOnline（RDOL）自托管后端：WebSocket 联机服务 + HTTP 谱面/版本接口，SQLite 存储",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p .",
    "start": "node dist/index.js",
    "start:api": "node dist/api-server.js",
    "dev": "ts-node src/index.ts",
    "dev:api": "ts-node src/api-server.ts",
    "typecheck": "tsc -p . --noEmit"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.7",
    "pino": "^10.1.1",
    "pino-pretty": "^13.1.3",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.10.0",
    "@types/ws": "^8.5.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.0"
  }
}
